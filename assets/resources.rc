#include <winver.h>

// Application manifest (Common Controls v6 + DPI awareness).
1 24 "DesktopDrawers.manifest"

// Application icon. The .ico is optional; only reference it if present so
// builds succeed on a fresh checkout without the binary asset.
// IDI_APP 1 defined in win32::messages.
// (Uncomment once assets/DesktopDrawers.ico exists.)
// 1 ICON "DesktopDrawers.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DesktopDrawers"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "DesktopDrawers"
            VALUE "OriginalFilename", "DesktopDrawers.exe"
            VALUE "ProductName", "DesktopDrawers"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
